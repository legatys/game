<mxfile host="generate_uml.py" type="device"><diagram id="page-0" name="Обзор пакетов"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legend-1" parent="1" value='&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;&lt;span style="background:#d5e8d4;border:1px solid #82b366"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «interface»&lt;br&gt;&lt;span style="background:#fff2cc;border:1px solid #d6b656"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «abstract»&lt;br&gt;&lt;span style="background:#e1d5e7;border:1px solid #9673a6"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «ScriptableObject»&lt;br&gt;&lt;span style="background:#dae8fc;border:1px solid #6c8ebf"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «MonoBehaviour»&lt;br&gt;&lt;span style="background:#eeeeee;border:1px solid #999999"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «static»&lt;br&gt;&lt;span style="background:#ffe6cc;border:1px solid #d79b00"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «struct»&lt;br&gt;&lt;span style="background:#ffe6cc;border:1px solid #d79b00"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «enum»&lt;br&gt;&lt;span style="background:#f8cecc;border:1px solid #b85450"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «Editor»&lt;br&gt;&lt;span style="background:#ffffff;border:1px solid #666666"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «class»&lt;br&gt;&lt;br&gt;—▷ наследование&lt;br&gt;- -▷ реализация интерфейса&lt;br&gt;◆— владеет (композиция)&lt;br&gt;—&gt; ссылается (ассоциация)&lt;br&gt;- -&gt; использует (зависимость)&lt;br&gt;&lt;br&gt;&lt;font color="#b00000"&gt;[Pattern]&lt;/font&gt; — паттерн проектирования&lt;br&gt;Пунктирные серые блоки — классы из других пакетов' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalA